{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*\\.php)",
      "destination": "https://practicore-production.up.railway.app/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://practicore-production.up.railway.app/uploads/$1"
    }
  ]
}