{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/(.*\\.php)$",
      "dest": "https://practicore-vjj8.onrender.com/$1"
    },
    {
      "src": "^/uploads/(.*)$",
      "dest": "https://practicore-vjj8.onrender.com/uploads/$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}